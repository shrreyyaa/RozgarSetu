# SETU LMIS — Environment Variables

# Database Connection URL (defaults to backend/data/lmis.db SQLite file)
DATABASE_URL=sqlite:///backend/data/lmis.db

# Hosted database example (e.g., PostgreSQL for multi-tenant production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lmis

# API Server Host and Port
PORT=8000
HOST=0.0.0.0
